# LLM settings (any OpenAI-compatible API).
# Default: free local model served by the ollama container in docker-compose.yml, no key needed.
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen2.5:3b

# Model the ollama container downloads on first start (keep it equal to LLM_MODEL when using Ollama)
OLLAMA_MODEL=qwen2.5:3b

# To use OpenAI instead, set:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Host port the API is published on (http://localhost:PORT)
PORT=8000
